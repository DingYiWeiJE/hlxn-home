generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 用户相关
// ============================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id        String    @id @default(cuid())
  username  String    @unique
  email     String?   @unique
  password  String
  role      UserRole  @default(ADMIN)
  isActive  Boolean   @default(true)
  lastLogin DateTime?

  mediaAssets MediaAsset[] @relation("MediaAssetCreatedBy")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
}

// ============================================================
// 新闻相关
// ============================================================

enum NewsStatus {
  DRAFT
  PUBLISHED
}

enum NewsLocale {
  zh
  en
}

enum NewsSourceType {
  MANUAL
  WECHAT
}

enum NewsType {
  DYNAMIC
  EVENT
}

model News {
  id String @id @default(cuid())

  // 基础信息
  title  String
  slug   String
  locale NewsLocale

  summary String? @db.Text

  // 封面图使用本地素材库
  coverImageAssetId String?
  coverImageAsset   MediaAsset? @relation("NewsCoverImage", fields: [coverImageAssetId], references: [id], onDelete: SetNull)

  coverImageAlt String?

  // Tiptap JSON 正文
  content Json

  // 用于后台搜索、SEO 和纯文本摘要
  contentText String? @db.Text

  authorName String?

  status     NewsStatus @default(DRAFT)
  isFeatured Boolean    @default(false)
  newsType   NewsType   @default(DYNAMIC)

  // 内容来源
  sourceType NewsSourceType @default(MANUAL)

  // 微信公众号原文地址
  sourceUrl String? @db.Text

  // 公众号名称
  sourceAccountName String?

  // 微信文章唯一标识或规范化地址哈希
  sourceArticleId String?

  // 微信公众号原始发布时间
  sourcePublishedAt DateTime?

  // 导入到本系统的时间
  importedAt DateTime?

  // 保存解析过程中的其他信息
  // 例如原始标题、微信参数、版权声明等
  importMeta Json?

  // 本网站的实际发布时间
  publishedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([slug, locale])
  // 同一篇微信公众号文章，同一种语言只能导入一次
  @@unique([sourceArticleId, locale])
  @@index([locale, status, publishedAt])
  @@index([status, publishedAt])
  @@index([deletedAt])
  @@index([isFeatured])
  @@index([coverImageAssetId])
  @@index([sourceType])
  @@index([sourcePublishedAt])
}

// ============================================================
// 媒体资源相关
// ============================================================

enum MediaAssetType {
  IMAGE
  PDF
}

enum MediaAssetPurpose {
  GENERAL

  PRODUCT_COVER
  PRODUCT_INTRO_BACKGROUND
  PRODUCT_ADVANTAGE
  PRODUCT_APPLICATION

  SOLUTION_WORKING_PRINCIPLE_BACKGROUND
  SOLUTION_USAGE_SCENARIO
  SOLUTION_CUSTOMER_VALUE

  APPLICATION_CASE_IMAGE
  COMPANY_HISTORY_IMAGE

  NEWS_COVER
  NEWS_CONTENT

  STRATEGIC_LOCATION_IMAGE
}

model MediaAsset {
  id String @id @default(cuid())

  type MediaAssetType @default(IMAGE)

  url          String  @unique
  relativePath String  @unique
  filename     String
  originalName String?

  mimeType String
  size     Int

  checksum String?

  width  Int?
  height Int?
  alt    String?

  purpose MediaAssetPurpose @default(GENERAL)

  enabled Boolean @default(true)

  createdById                         String?
  createdBy                           User?      @relation("MediaAssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  productIntroBackgrounds             Product[]  @relation("ProductIntroBackgroundImage")
  solutionCovers                      Solution[] @relation("SolutionCoverImage")
  solutionWorkingPrincipleBackgrounds Solution[] @relation("SolutionWorkingPrincipleBackgroundImage")

  advantages             ProductAdvantage[]
  applications           ProductApplication[]
  solutionUsageScenarios SolutionUsageScenario[]
  solutionCustomerValues SolutionCustomerValue[]

  productPdfs           Product[]            @relation("ProductDetailPdf")
  productCovers         Product[]            @relation("ProductCoverImage")
  newsCovers            News[]               @relation("NewsCoverImage")
  applicationCaseImages ApplicationCase[]    @relation("ApplicationCaseImage")
  companyHistoryEvents  CompanyHistoryEvent[] @relation("CompanyHistoryEventImage")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  @@index([type, createdAt])
  @@index([type, enabled, deletedAt])
  @@index([createdById])
  @@index([deletedAt])
  @@index([purpose, createdAt])
}

// ============================================================
// 公司发展历程相关
// ============================================================

enum CompanyHistoryLocale {
  zh
  en
}

model CompanyHistoryYear {
  id     String               @id @default(cuid())
  locale CompanyHistoryLocale
  year   Int

  sortDate DateTime
  sortOrder Int @default(0)

  events CompanyHistoryEvent[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([locale, year])
  @@index([locale, sortDate, sortOrder])
  @@index([deletedAt])
}

model CompanyHistoryEvent {
  id              String @id @default(cuid())
  historyYearId   String
  historyYear     CompanyHistoryYear @relation(fields: [historyYearId], references: [id], onDelete: Cascade)

  time             String
  content          String @db.Text
  imageAssetId     String?
  imageAsset       MediaAsset? @relation("CompanyHistoryEventImage", fields: [imageAssetId], references: [id], onDelete: SetNull)

  sortOrder Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([historyYearId, sortOrder])
  @@index([imageAssetId])
  @@index([deletedAt])
}

// ============================================================
// 产品分类相关
// ============================================================

enum CategoryLevel {
  LEVEL_ONE
  LEVEL_TWO
}

model Category {
  id        String        @id @default(cuid())
  name      String
  nameEn    String        @default("")
  slug      String        @unique
  level     CategoryLevel
  parentId  String?
  sortOrder Int           @default(0)
  enabled   Boolean       @default(true)

  // 分类自关联
  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryChildren")

  // 产品只关联二级分类
  products Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // 防止同一个父级分类下出现同名分类
  // 一级分类 parentId 为 null 时，仍建议在业务层检查重名
  @@unique([parentId, name])
  @@index([parentId, sortOrder])
  @@index([level, enabled])
  @@index([deletedAt])
}

// ============================================================
// 产品相关
// ============================================================

enum ProductStatus {
  DRAFT
  PUBLISHED
  OFFLINE
}

enum ProductLocale {
  zh
  en
}

enum SolutionStatus {
  DRAFT
  PUBLISHED
}

enum SolutionLocale {
  zh
  en
}

enum ApplicationCaseLocale {
  zh
  en
}

enum StrategicLocationType {
  HEADQUARTERS
  BRANCH
  MARKETING
  SERVICE
}

enum StrategicLocationStatus {
  DRAFT
  PUBLISHED
}

model Product {
  id         String        @id @default(cuid())
  name       String
  slug       String
  locale     ProductLocale @default(zh)
  seriesName String?

  secondaryCategoryId String

  summaryParagraphs      Json @default("[]")
  highlights             Json @default("[]")
  introductionParagraphs Json @default("[]")

  specificationTitle   String?
  specificationHeaders Json?
  specificationRows    Json?

  // 产品封面图片
  coverImageAssetId String?

  // 产品详情 PDF
  detailPdfAssetId String?

  status                      ProductStatus @default(DRAFT)
  sortOrder                   Int           @default(0)
  introBackgroundImageAssetId String?

  secondaryCategory Category @relation(fields: [secondaryCategoryId], references: [id], onDelete: Restrict)

  coverImageAsset           MediaAsset? @relation("ProductCoverImage", fields: [coverImageAssetId], references: [id], onDelete: SetNull)
  detailPdfAsset            MediaAsset? @relation("ProductDetailPdf", fields: [detailPdfAssetId], references: [id], onDelete: SetNull)
  introBackgroundImageAsset MediaAsset? @relation("ProductIntroBackgroundImage", fields: [introBackgroundImageAssetId], references: [id], onDelete: SetNull)

  advantages   ProductAdvantage[]
  applications ProductApplication[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // 同一种语言下 slug 唯一
  // zh 和 en 可以使用相同 slug
  @@unique([slug, locale])
  @@index([locale, status, sortOrder])
  @@index([locale, secondaryCategoryId, status, sortOrder])
  @@index([secondaryCategoryId, status, sortOrder])
  @@index([status, sortOrder])
  @@index([coverImageAssetId])
  @@index([detailPdfAssetId])
  @@index([deletedAt])
}

// ============================================================
// 产品优势
// ============================================================

model ProductAdvantage {
  id        String @id @default(cuid())
  productId String
  assetId   String
  title     String
  sortOrder Int    @default(0)

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, sortOrder])
  @@index([assetId])
}

// ============================================================
// 产品应用场景
// ============================================================

model ProductApplication {
  id        String @id @default(cuid())
  productId String
  assetId   String
  title     String
  sortOrder Int    @default(0)

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, sortOrder])
  @@index([assetId])
}

// ============================================================
// 解决方案分类相关
// ============================================================

model SolutionCategory {
  id     String @id @default(cuid())
  chName String
  enName String

  solutions Solution[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
}

// ============================================================
// 瑙ｅ喅鏂规鐩稿叧
// ============================================================

model Solution {
  id     String         @id @default(cuid())
  locale SolutionLocale @default(zh)
  title  String
  subtitle String?
  slug   String

  status    SolutionStatus @default(DRAFT)
  sortOrder Int            @default(0)

  coverImageAssetId                 String?
  summaryParagraphs                 Json    @default("[]")
  highlights                        Json    @default("[]")
  workingPrincipleParagraphs        Json    @default("[]")
  workingPrincipleBackgroundAssetId String?
  systemCompositionParagraphs       Json    @default("[]")

  translationKey String?
  categoryId     String?

  createdBy String?
  updatedBy String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  coverImageAsset                     MediaAsset? @relation("SolutionCoverImage", fields: [coverImageAssetId], references: [id], onDelete: SetNull)
  workingPrincipleBackgroundAsset     MediaAsset? @relation("SolutionWorkingPrincipleBackgroundImage", fields: [workingPrincipleBackgroundAssetId], references: [id], onDelete: SetNull)
  category                            SolutionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  usageScenarios SolutionUsageScenario[]
  customerValues SolutionCustomerValue[]

  @@unique([locale, slug])
  @@unique([translationKey, locale])
  @@index([translationKey])
  @@index([categoryId])
  @@index([locale, status, sortOrder])
  @@index([status, sortOrder])
  @@index([coverImageAssetId])
  @@index([workingPrincipleBackgroundAssetId])
  @@index([deletedAt])
}

model SolutionUsageScenario {
  id               String @id @default(cuid())
  solutionId       String
  imageAssetId     String?
  title            String
  detailParagraphs Json   @default("[]")
  sortOrder        Int    @default(0)

  solution   Solution   @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  imageAsset MediaAsset? @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([solutionId, sortOrder])
  @@index([imageAssetId])
}

model SolutionCustomerValue {
  id               String @id @default(cuid())
  solutionId       String
  imageAssetId     String?
  title            String
  detailParagraphs Json   @default("[]")
  sortOrder        Int    @default(0)

  solution   Solution   @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  imageAsset MediaAsset? @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([solutionId, sortOrder])
  @@index([imageAssetId])
}

// ============================================================
// 应用案例相关
// ============================================================

model ApplicationCase {
  id     String                @id @default(cuid())
  locale ApplicationCaseLocale
  title  String
  slug   String

  contentParagraphs Json     @default("[]")
  caseDate          DateTime

  imageAssetId String
  imageAsset   MediaAsset @relation("ApplicationCaseImage", fields: [imageAssetId], references: [id], onDelete: Restrict)

  createdById String?
  updatedById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([locale, slug])
  @@index([locale, caseDate])
  @@index([deletedAt, caseDate])
  @@index([createdAt])
  @@index([imageAssetId])
}

// ============================================================
// 战略布局网点相关
// ============================================================

model StrategicLocation {
  id   String @id @default(cuid())
  code String @unique

  nameZh String
  nameEn String

  type StrategicLocationType

  countryCode   String
  countryNameZh String
  countryNameEn String

  provinceNameZh String?
  provinceNameEn String?
  cityNameZh     String?
  cityNameEn     String?

  addressZh String?
  addressEn String?

  longitude Decimal @db.Decimal(10, 6)
  latitude  Decimal @db.Decimal(10, 6)

  establishment String?
  staff         Int?

  descriptionZh String? @db.Text
  descriptionEn String? @db.Text

  businessScopeZh Json @default("[]")
  businessScopeEn Json @default("[]")

  imageUrl String? @db.Text

  status    StrategicLocationStatus @default(DRAFT)
  enabled   Boolean                 @default(true)
  sortOrder Int                     @default(0)

  createdById String?
  updatedById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, enabled, sortOrder])
  @@index([countryCode, status, enabled])
  @@index([provinceNameZh])
  @@index([deletedAt])
}

// ============================================================
// 联系我们相关
// ============================================================

enum ContactSubmissionType {
  CUSTOMER
  MEDIA
  EVENT_ORGANIZER
}

enum ContactSubmissionStatus {
  PENDING
  FOLLOWING_UP
  CONTACTED
  COMPLETED
  INVALID
  SPAM
}

enum ContactSubmissionRiskLevel {
  LOW
  MEDIUM
  HIGH
  BLOCKED
}

enum ContactSubmissionNotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model ContactSubmission {
  id     String                @id @default(cuid())
  type   ContactSubmissionType
  locale String // zh or en

  contactName     String
  phone           String?
  phoneNormalized String?
  email           String?
  emailNormalized String?

  status      ContactSubmissionStatus    @default(PENDING)
  riskLevel   ContactSubmissionRiskLevel @default(LOW)
  riskReasons Json                       @default("[]") // array of strings

  isDuplicate     Boolean             @default(false)
  duplicateOfId   String?
  duplicateReason String?
  duplicateOf     ContactSubmission?  @relation("Duplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates      ContactSubmission[] @relation("Duplicates")

  contentFingerprint String?
  idempotencyKey     String?

  sourcePath String?
  referrer   String?
  ipHash     String?
  userAgent  String?

  consentAt            DateTime?
  privacyPolicyVersion String?

  notificationStatus ContactSubmissionNotificationStatus @default(PENDING)
  notificationError  String?

  submittedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  customerInquiry       CustomerInquiry?
  mediaInquiry          MediaInquiry?
  eventOrganizerInquiry EventOrganizerInquiry?
  notes                 ContactSubmissionNote[]

  @@unique([idempotencyKey])
  @@index([type])
  @@index([locale])
  @@index([status])
  @@index([riskLevel])
  @@index([isDuplicate])
  @@index([duplicateOfId])
  @@index([emailNormalized])
  @@index([phoneNormalized])
  @@index([contentFingerprint])
  @@index([submittedAt])
  @@index([deletedAt])
  @@index([notificationStatus])
}

model CustomerInquiry {
  id           String            @id @default(cuid())
  submissionId String            @unique
  submission   ContactSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  companyName  String
  mainBusiness String
  regionDetail String

  jobTitle String?

  applicationType String? // PASSENGER_VEHICLE, BUS, LOGISTICS_VEHICLE, ENERGY_STORAGE, OTHER
  productType     String? // CELL, MODULE, BATTERY_PACK, BMS, OTHER
  chemicalSystem  String? // TERNARY, LFP, EITHER
  cellShape       String? // PRISMATIC, OTHER

  specificScenario     String?
  unitPackCapacityKwh  Decimal?
  unitPackVoltageV     Decimal?
  spaceDimensions      String?
  annualElectricityKwh Decimal?
  chargingHours        Decimal?
  otherRequirements    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submissionId])
}

model MediaInquiry {
  id           String            @id @default(cuid())
  submissionId String            @unique
  submission   ContactSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  mediaName String

  inquiryPurpose String? // ADVERTISING, INTERVIEW, VISIT, EVENT, OTHER
  details        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submissionId])
}

model EventOrganizerInquiry {
  id           String            @id @default(cuid())
  submissionId String            @unique
  submission   ContactSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  eventName     String
  organizerName String
  location      String

  startAt DateTime
  endAt   DateTime

  inquiryPurpose String? // EXHIBITION, FORUM, ASSOCIATION, OTHER
  details        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submissionId])
  @@index([startAt])
  @@index([endAt])
}

model ContactSubmissionNote {
  id           String            @id @default(cuid())
  submissionId String
  submission   ContactSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  content     String
  createdById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([submissionId])
  @@index([createdById])
  @@index([deletedAt])
}

// ============================================================
// 访问统计相关
// ============================================================

model AnalyticsSession {
  id String @id @default(cuid())

  sessionId     String   @unique
  visitorId     String
  startedAt     DateTime @default(now())
  lastActiveAt  DateTime @default(now())
  ipHash        String?
  userAgent     String?
  isBot         Boolean  @default(false)

  pageViews AnalyticsPageView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visitorId])
  @@index([startedAt])
  @@index([isBot])
}

enum AnalyticsResourceType {
  page
  product
  news
  solution
  case
  contact
}

model AnalyticsPageView {
  id String @id @default(cuid())

  eventId      String   @unique
  visitorId    String
  sessionId    String
  session      AnalyticsSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  resourceType AnalyticsResourceType
  resourceId   String?
  path         String

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([visitorId])
  @@index([resourceType, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([createdAt])
}

// ============================================================
// CMS 内容管理系统相关
// ============================================================

enum CmsBackgroundLocation {
  HOMEPAGE
  ABOUT_US
  SOLUTIONS
  PRODUCTS
  APPLICATION_CASES
  NEWS
  CONTACT_US
}

enum CmsBrochureLanguage {
  zh
  en
}

model CmsBackgroundImage {
  id String @id @default(cuid())

  location CmsBackgroundLocation @unique
  type String // "image" 或 "video"

  relativePath String @unique // 存储七牛云相对路径，如 cms/backgrounds/image/homepage
  filename String
  mimeType String
  size Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([location])
  @@index([deletedAt])
}

model CmsBrochure {
  id String @id @default(cuid())

  language CmsBrochureLanguage

  relativePath String @unique // 存储七牛云相对路径，如 cms/brochures/zh
  filename String
  mimeType String
  size Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([language])
  @@index([deletedAt])
}

model CmsPartner {
  id String @id @default(cuid())

  imageRelativePath String // 图片相对路径，必传
  imageFilename String
  imageMimeType String
  imageSize Int

  websiteUrl String? // 官网地址，可选

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
}

model CmsContactMethod {
  id String @id @default(cuid())

  language String // "zh" 或 "en"
  title String // 如 "电话"、"邮箱"、"微信"
  value String // 联系方式的实际值

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([language])
  @@index([deletedAt])
}

model CmsCompanyAddress {
  id String @id @default(cuid())

  language String // "zh" 或 "en"
  address String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([language])
  @@index([deletedAt])
}

model CmsCompanyHonor {
  id String @id @default(cuid())

  imageRelativePath String // 图片相对路径
  imageFilename String
  imageMimeType String
  imageSize Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
}

model CmsWorkshopImage {
  id String @id @default(cuid())

  imageRelativePath String // 图片相对路径
  imageFilename String
  imageMimeType String
  imageSize Int

  title String? // 可选标题

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
}

model CmsBranchImage {
  id String @id @default(cuid())

  imageRelativePath String // 图片相对路径
  imageFilename String
  imageMimeType String
  imageSize Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
}
